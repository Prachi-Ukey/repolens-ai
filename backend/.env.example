# RepoLens AI Environment Configuration

# Application Mode & Core Settings
APP_ENV=development
DEBUG=True

# JWT Secret Key:
# - In development: If omitted or set to the placeholder below, a safe local fallback key is used.
# - In production (APP_ENV=production): MUST be a cryptographically secure random string (e.g. `openssl rand -hex 32`).
#   The application fails fast on startup in production if this placeholder or any default/short key is used.
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins:
# - Development: Can be '*' or 'http://localhost:5173,http://localhost:3000'
# - Production: MUST be the exact deployed frontend origin (e.g., 'https://repolens-ai.vercel.app').
#   Wildcard '*' will cause browser credential/authentication errors when user sessions are enabled.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# SQLite local or persistent volume:
DATABASE_URL=sqlite:///./repolens.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repolens_db

# AI & LLM Configuration
# Options: ollama, openai, gemini, mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# For Docker container accessing host Ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Hosted LLMs (for Production Cloud Deployment):
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Configuration
# Options: mock, local (sentence-transformers), openai, gemini
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384

# GitHub REST API Token (Optional, increases rate limit for public repos)
GITHUB_TOKEN=

# Vector Database (ChromaDB local storage directory)
CHROMA_PERSIST_DIRECTORY=./chroma_data
