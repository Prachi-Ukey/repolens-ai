# RepoLens AI Environment Configuration

# Application Mode & Core Settings
APP_ENV=development
DEBUG=True
SECRET_KEY=repolens-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Fallback to SQLite if DATABASE_URL is not set or PostgreSQL unavailable
DATABASE_URL=sqlite:///./repolens.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repolens_db

# AI & LLM Configuration
# Options: mock, openai, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Configuration
# Options: mock, openai, gemini
EMBEDDING_PROVIDER=mock

# GitHub REST API Token (Optional, increases rate limit for public repos)
GITHUB_TOKEN=

# Vector Database (ChromaDB local storage directory)
CHROMA_PERSIST_DIRECTORY=./chroma_data
